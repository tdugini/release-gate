FROM node:22-alpine AS web-build
WORKDIR /web

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./
ARG VITE_DEMO_ACCESS_TOKEN=releasegate-demo-viewer
ENV VITE_DEMO_ACCESS_TOKEN=$VITE_DEMO_ACCESS_TOKEN
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api-build
WORKDIR /src

COPY ReleaseGate.slnx ./
COPY apps/api/ReleaseGate.Api/ReleaseGate.Api.csproj apps/api/ReleaseGate.Api/
RUN dotnet restore apps/api/ReleaseGate.Api/ReleaseGate.Api.csproj

COPY apps/api/ReleaseGate.Api/ apps/api/ReleaseGate.Api/
COPY --from=web-build /web/dist apps/api/ReleaseGate.Api/wwwroot

RUN dotnet publish apps/api/ReleaseGate.Api/ReleaseGate.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_ENVIRONMENT=Production \
    DemoMode__Enabled=true \
    ControlPlaneAuth__Tokens__0__Token=releasegate-demo-viewer \
    ControlPlaneAuth__Tokens__0__Subject=portfolio-demo \
    ControlPlaneAuth__Tokens__0__DisplayName="Portfolio Demo"

COPY --from=api-build /app/publish ./

USER app
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "ASPNETCORE_HTTP_PORTS=${PORT:-8080} exec dotnet ReleaseGate.Api.dll"]
