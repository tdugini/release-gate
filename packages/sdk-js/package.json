{
  "name": "@releasegate/sdk-js",
  "version": "0.1.0",
  "description": "JavaScript SDK for consuming ReleaseGate runtime feature flag snapshots.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdugini/release-gate.git",
    "directory": "packages/sdk-js"
  },
  "homepage": "https://github.com/tdugini/release-gate#readme",
  "bugs": {
    "url": "https://github.com/tdugini/release-gate/issues"
  },
  "keywords": [
    "feature-flags",
    "progressive-delivery",
    "rollout",
    "releasegate"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
